# Knape & Associates — instance environment
#
# Peter's CRM. Copy to the repo root as `.env` (VPS) or into the Vercel
# project's environment variables.
#
# ONLY the variables that differ from NuraView's own instance are listed. Every
# BRAND_* key falls back to NuraView's value when unset — see
# apps/api/src/utils/get-brand.ts — so an incomplete file here does not fail
# loudly, it quietly ships NuraView's identity to Peter's users. Set all of them.
#
# The BRAND_* keys are read in two places for two different reasons:
#   * apps/api at request time, served over GET /api/config
#   * apps/app at BUILD time, stamped into index.html + site.webmanifest by
#     vite-plugin-brand-html.ts (the <head> is consumed before any JS runs)
# so they must be present in BOTH the build and runtime environments.

# ── Identity ──────────────────────────────────────────────────────────────────
BRAND_NAME="Knape & Associates"
BRAND_SHORT_NAME="Knape"
BRAND_MONOGRAM="K"
BRAND_TAGLINE="Industrial HVAC representation"
BRAND_DESCRIPTION="Leads, outreach and pipeline for Knape & Associates."
BRAND_LEGAL_NAME="Knape & Associates"
BRAND_SUPPORT_EMAIL="peter@knapesolutions.com"
BRAND_MARKETING_URL="https://knapesolutions.com"
# The host this instance is served from. Only used to build absolute URLs in
# outbound mail and the OG card, so it has to be the public one, not the port.
BRAND_SITE_URL="https://crm.knapesolutions.com"

# ── Assets ────────────────────────────────────────────────────────────────────
# Generated from Knape-Logo-500px.png by
# scripts/one-off/20260805-knape-brand-assets.py, which explains the artwork.
#
# The lockup is TWO-TONE: a charcoal disc carrying a cyan "K", beside a charcoal
# wordmark. The wordmark is invisible on the dark theme, so a light-theme
# variant sits beside it with the lettering recoloured to near-white, and the
# app picks between them:
#   /brand/knape-logo.png       dark surfaces (wordmark recoloured)
#   /brand/knape-logo-dark.png  light surfaces (as supplied, auto-resolved —
#                               do not set this one, the `-dark` suffix is a
#                               convention BrandWordmark resolves itself)
BRAND_LOGO_URL="/brand/knape-logo.png"
BRAND_OG_IMAGE_URL="https://crm.knapesolutions.com/brand/knape-og.png"

# The tab icons. These are the disc mark with its two colours SWAPPED — a cyan
# tile with the K knocked out in charcoal — because the mark as supplied is a
# charcoal circle, and at 16px a charcoal circle is the same dark blob as every
# other favicon in the tab strip. Bright cyan is the one difference that still
# survives at that size.
#
# All four are needed. The .ico is what Chrome actually paints in the tab
# (16/24/32/48/64/128/256 frames, each composed at its own size); the .png is
# for browsers that prefer one; apple-touch is Safari and Add to Home Screen.
# Leave the last two unset and the build serves NuraView's /favicon.ico and
# /apple-touch-icon.png from the root, which is where Safari and most tooling
# look regardless of what the <head> declares.
BRAND_FAVICON_URL="/brand/knape-icon-192.png"
BRAND_FAVICON_ICO_URL="/brand/knape-favicon.ico"
BRAND_APPLE_TOUCH_ICON_URL="/brand/knape-apple-touch-icon.png"

# PWA install icons. Distinct from the favicon: leave these unset and the
# home-screen tile falls back to /web-app-manifest-*.png, which is NuraView's.
# The maskable one is drawn smaller on purpose — Android crops it to a circle.
BRAND_ICON_192_URL="/brand/knape-icon-192.png"
BRAND_ICON_512_URL="/brand/knape-icon-512.png"
BRAND_ICON_MASKABLE_URL="/brand/knape-icon-maskable-512.png"

# ── Palette ───────────────────────────────────────────────────────────────────
# The logo has exactly two inks: cyan #0693cf and charcoal #231f20. Nothing
# else was invented.
#
# The accent drives buttons, active nav and focus rings; without it the app
# keeps NuraView's neutral-800 primary and still looks like the vendor's
# product. themeColor only reaches the PWA manifest and browser chrome.
#
# The foreground is the CHARCOAL, not white. White on this cyan is 3.4:1 —
# below AA for body text — while charcoal on it is 6.1:1. It is also the
# pairing the logo itself uses, where the cyan K sits against the charcoal disc.
BRAND_ACCENT_COLOR="#0693cf"
BRAND_ACCENT_FOREGROUND="#231f20"
BRAND_THEME_COLOR="#231f20"
BRAND_BACKGROUND_COLOR="#231f20"

# ── Instance shape ────────────────────────────────────────────────────────────
# "none", NOT unset. Unset means "this instance has a legacy Next app at
# crmx1.nuraview.com" — which would put a link into NuraView's internal CRM in
# Peter's sidebar. The sentinel means "there is no legacy app", and the entries
# are hidden instead. (Empty string would say the same thing, but Vercel
# refuses to store an empty variable.)
BRAND_LEGACY_BASE_URL="none"

# Hides the "Business" group (Projects / Members / Invitations / Employees).
# This instance is a lead-gen cockpit, not a project tracker.
BRAND_HIDE_PROJECTS=true

# Plausible is NuraView's analytics. Empty disables it entirely rather than
# reporting a client's traffic to the vendor's dashboard.
BRAND_ANALYTICS_DOMAINS=""

# What the PWA opens to when installed from the home screen.
BRAND_PWA_START_URL="/leads"

# ── Email signature ───────────────────────────────────────────────────────────
# Appended to outbound mail composed in the CRM. Left unset, this signs Peter's
# outreach as NuraView's founder.
BRAND_SIGNATURE_NAME="Peter Wuensch"
BRAND_SIGNATURE_TITLE="Knape & Associates"
BRAND_SIGNATURE_PHOTO_URL=""
BRAND_SIGNATURE_PHONE=""
BRAND_SIGNATURE_SCHEDULING_URL=""
BRAND_SIGNATURE_LINKEDIN_URL=""
BRAND_SIGNATURE_LINKEDIN_LABEL=""
BRAND_SIGNATURE_WEBSITE_URL="https://knapesolutions.com"
BRAND_SIGNATURE_WEBSITE_LABEL="knapesolutions.com"
BRAND_SIGNATURE_LEGAL_LINE=""
BRAND_SIGNATURE_ADDRESS_LINE=""

# ── What the business does (AI drafting) ──────────────────────────────────────
# The single most load-bearing pair of lines in the LinkedIn drafter's prompt:
# everything the model writes is downstream of them. Left empty, the prompt says
# outright that it does not know the product and the drafts come back cautious
# and generic — recoverable. Filled in WRONG, they come back fluent and false.
BRAND_BUSINESS_BRIEF="The business represents industrial HVAC and air-handling equipment (ventilation, process air, blowers, dampers) to manufacturers, marine and offshore operators, oil and gas, utilities and EPC contractors. It sells engineering judgement and specification support, not a catalogue."
BRAND_AUDIENCE_BRIEF="The audience is design and project engineers, plant and facilities managers, procurement leads and the directors above them, at industrial manufacturers and the contractors who build for them. They buy on specification fit, schedule and total cost, and they are usually deciding while a plant, line or project is being designed."

# ── Databases ─────────────────────────────────────────────────────────────────
# The CRM's OWN two schemas. These are NOT the lead pipeline's database — the
# pipeline is reached over HTTP through the leadgen proxy below, never by
# sharing a connection string with it.
#
# Both live in the `leadgen-pg` container on the VPS (127.0.0.1:5544), the same
# Postgres the lead pipeline uses, in separate databases beside it.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5544/knape_pm"
CRM_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5544/knape_crm"

# ── Auth ──────────────────────────────────────────────────────────────────────
# `openssl rand -base64 32`. Both names are read; keep them identical.
AUTH_SECRET=""
BETTER_AUTH_SECRET=""
# Internal tool, fixed users, no public sign-up. Provision the first account
# with `bun run pm:seed`.
DISABLE_REGISTRATION=true
APP_URL="https://crm.knapesolutions.com"
NURAVIEW_CLIENT_URL="https://crm.knapesolutions.com"
CORS_ORIGINS="https://crm.knapesolutions.com"

# ── Leadgen cockpit ───────────────────────────────────────────────────────────
# The FastAPI cockpit that serves the lead board, the email surface and the
# sending mailboxes. The Hono API reaches it server-side so the browser never
# sees a second origin or a second login.
#
# This instance runs its OWN cockpit process (systemd `knape-dash-api`, port
# 8790) reading the SAME `leadgen` database as the existing `cockpit-api`
# service on 8787. Two readers, one dataset: the 8787 service keeps running the
# discovery and enrichment pipeline exactly as it does today, and this one only
# serves the dashboard. Do not point this at 8787 — that build of the cockpit
# is ~40 endpoints behind what this UI calls, and the Emails, Inboxes and
# Campaign panes would 404.
LEADGEN_API_BASE="http://127.0.0.1:8790"
LEADGEN_API_EMAIL=""
LEADGEN_API_PASSWORD=""
LEADGEN_API_TOKEN=""

# ── Optional ──────────────────────────────────────────────────────────────────
# AI drafting ("Draft with AI"). Without it those endpoints return 503 saying
# so, and everything else is unaffected.
OPENAI_API_KEY=""

# Required for the Vercel Cron entries in apps/app/vercel.json, which Vercel
# sends as `Authorization: Bearer $CRON_SECRET`. Not needed on the VPS, where
# cron runs from the host crontab.
CRON_SECRET=""

# Auto-detected from Vercel's own VERCEL env var; only needed to override.
# "poll" because a Vercel Function cannot hold a WebSocket open.
# REALTIME_TRANSPORT="poll"
