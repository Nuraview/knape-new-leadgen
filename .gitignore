# Monorepo root. Each app has its own .gitignore for app-specific rules:
#   apps/web/.gitignore       — Next.js / Node
#   apps/scraper/.gitignore   — Python
#   apps/whatsapp/.gitignore  — Node / Baileys
#
# Only repo-root cruft belongs here.

.DS_Store

# Dependencies. The root is now a bun workspace, so node_modules is installed
# HERE rather than only under apps/web — which previously had the only
# .gitignore covering it.
node_modules/
.pnp
.pnp.js

# Build output / caches that can surface at the root
.next/
.turbo/
*.tsbuildinfo

# Editor / IDE
.idea/
.vscode/
.cursor/

# Local Claude / agent state — keep settings.local.json local
.claude/settings.local.json

# Worktrees
.worktrees/

# Ephemeral
.omo/
.vercel

# Database backups (pg_dump) — contain data + secrets, never commit
backups/
*.sql.err
.env*
# ...but *.example files carry no secrets and must be committed, otherwise a
# fresh clone has no way to know which vars the apps need.
!.env.example
!**/.env.example
nvcrm_backup*.sql
mkt_dump*.sql

# Playwright MCP session artifacts
.playwright-mcp/

# Trello board exports — contain card contents and member names; import them
# with apps/api/scripts/import-trello.ts rather than committing them.
*- nuraview-*.json
*- habibs-*.json

# Loose credential files. `.env*` above covers the env-file case; this covers
# the one that actually happened — a provider key pasted into a shell and
# landing as a FILENAME in the repo root, one `git add -A` away from GitHub.
*sk_live*
*rk_live*
*sk_test_*
*rk_test_*
*whsec_*
*.pem
*.p12

# Scratch notes. st.md once held a full live Stripe secret key and was
# committed by accident (see d6657a13) — never again.
st.md
*.secrets.md

# Build output. The API image compiles this during `docker build`; a local
# `bun run build` must never land in a commit as a 1.4MB generated blob.
apps/api/dist/

# Build artifacts — regenerated by `bun run build:packages` on every build
# (including Vercel's, see apps/app/vercel.json buildCommand). Tracking them
# put ~20 generated files in every diff and made review noise out of noise.
packages/*/dist/
packages/*/.cache/
**/tsbuildinfo.json
*.tsbuildinfo

# Credential notes dropped at the repo root (registrar logins, mailbox
# passwords). Never committed — keep it that way. Note the filename itself can
# carry the password, so these leak even if the file body is empty. Prefer a
# password manager; this is only a backstop.
/GoDaddy
/sysadmin @*
*credentials*
*creds*.txt
*password*.txt
