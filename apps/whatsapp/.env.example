# Shared bearer secret used in BOTH directions:
#   - CRM -> service: required on /qr, /status, /send
#   - service -> CRM: included on heartbeat + inbound POSTs
# Generate: openssl rand -hex 32
WHATSAPP_API_KEY=

# CRM origin (no trailing slash). Heartbeat + inbound webhooks POST here.
NEXTCRM_URL=https://nv-crm.vercel.app

PORT=3001
LOG_LEVEL=info

# Paired numbers. Comma-separated account slugs — one Baileys socket each.
# Default (unset) = "primary" only, i.e. the original single-number behaviour.
# To link a second number, list it here and redeploy; a card with its own QR
# appears on the CRM admin → WhatsApp page to scan.
#   - 'primary' keeps its creds in AUTH_DIR (the existing pairing — no re-scan)
#   - every other account stores creds in AUTH_DIR/<slug> (same mounted volume)
WHATSAPP_ACCOUNTS=primary,secondary
# Optional friendly names shown in the CRM (per account slug, uppercased):
# WHATSAPP_LABEL_PRIMARY=Main line
# WHATSAPP_LABEL_SECONDARY=Support line

# Outbound throttling — these defaults defend the paired number from
# patterns that flag bulk senders. Tune cautiously.
SEND_MIN_INTERVAL_MS=5000
SEND_DAILY_CAP=200
HEARTBEAT_INTERVAL_MS=30000
