{
  "name": "@nuraview/api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx scripts/seed-instance.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outdir=dist --format=esm --packages=external --external:fs --external:path --external:crypto --external:os --external:util --external:stream --external:buffer --external:events --external:url --external:querystring --external:http --external:https --external:net --external:tls --external:zlib --external:@modelcontextprotocol/sdk",
    "lint": "biome check --write .",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:user-data": "tsx scripts/seed-user-data.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "typecheck": "tsc --noEmit",
    "db:crm-apply": "tsx scripts/crm-apply.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@hono/node-server": "^2.0.10",
    "@hono/node-ws": "^1.3.1",
    "@hono/standard-validator": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nuraview/email": "workspace:*",
    "@nuraview/permissions": "workspace:*",
    "@octokit/webhooks": "^14.2.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/nodemailer": "^8.0.1",
    "@valibot/to-json-schema": "^1.7.1",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.9",
    "croner": "^10.0.1",
    "decimal.js": "^10.6.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "hono-openapi": "^1.3.1",
    "ioredis": "^5.11.1",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "octokit": "^5.0.5",
    "pg": "^8.22.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "twilio": "^6.0.2",
    "valibot": "^1.4.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
