# Both databases live on the VPS Postgres (nuraview-crm-pg) and are reached
# through ONE SSH tunnel. No local Docker is required:
#
#   bun run tunnel      # -L 15433:127.0.0.1:5433 root@185.245.182.175
#
# nuraview_pm  — this app's project/task/comment tables
# nuracrm      — the existing CRM (leads, enrichment, dialer); read-only here
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15433/nuraview_pm
CRM_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15433/nuracrm

AUTH_SECRET=change-me-must-be-at-least-32-characters-long
NURAVIEW_API_URL=http://localhost:1337
NURAVIEW_CLIENT_URL=http://localhost:5173

# Internal CRM: fixed users, no public sign-up. Staff are added by the admin
# via invitations. Provision the admin + workspace with `bun run pm:seed`.
DISABLE_REGISTRATION=true

# Proposal drafting ("Draft with AI" on the lead card). Without the key the two
# AI endpoints return 503 and the rest of the app is unaffected — nothing else
# in apps/api reads OPENAI_API_KEY.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5. Note the request sends max_completion_tokens and
# no temperature, which the gpt-5 family requires; an older model may need
# apps/api/src/proposal/ai/openai.ts adjusted.
PROPOSAL_AI_MODEL=gpt-5
# Optional. Pin the proposal a draft inherits its design and its terms from, by
# proposal NUMBER. Unset, the API picks the newest "Save as template" proposal,
# or failing that the richest recent one that has a design preset — which is
# how it works today, since there are no templates yet.
PROPOSAL_TEMPLATE_NUMBER=
