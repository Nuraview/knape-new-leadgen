# NuraView API (Hono).
#
# Built ON the VPS rather than pushed from CI for this first deploy — the image
# is small and the box has headroom for it, and it avoids standing up a GHCR
# pipeline before the app has ever run in production.
#
# Runs under Node rather than Bun: puppeteer/imap/sharp compatibility is
# unresolved (see the plan), and the API currently needs none of them, so there
# is no reason to take the risk on the first deploy.
FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Bun is used only as the package manager: the repo's lockfile is bun.lock, and
# installing with anything else would resolve different versions.
RUN npm install -g bun@1.3.1

# Deploy-only root manifest. The committed root package.json lists apps/web
# (the legacy Next app), which this image deliberately does not ship — with it
# present, the workspace set would not match and bun would fail.
COPY deploy/package.api.json ./package.json
COPY bun.lock bunfig.toml ./
COPY apps/api/package.json ./apps/api/
COPY packages/email/package.json ./packages/email/
COPY packages/libs/package.json ./packages/libs/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/permissions/package.json ./packages/permissions/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# NOT --frozen-lockfile: the lockfile describes the full workspace including
# apps/web, which is intentionally absent here. Versions still come from each
# package.json's ranges. Revisit once apps/web is retired and the lockfile
# matches the deployed set again.
RUN bun install

COPY packages ./packages
COPY apps/api ./apps/api
COPY i18n ./i18n

# permissions/email/mcp compile to dist/ and the API imports those entrypoints;
# a cold clone fails without this step.
RUN bun run --filter @nuraview/permissions build \
 && bun run --filter @nuraview/email build \
 && bun run --filter @nuraview/mcp build

WORKDIR /app/apps/api

# COMPILE AHEAD OF TIME.
#
# This image ran `npx tsx src/index.ts` — TypeScript transpiled at RUNTIME on
# every container start. Measured in production: 27 seconds from container start
# to the first log line, then 1.8s for migrations and plugins. All 28.8s was a
# hard outage, because nginx proxies to one container on one port and there is
# nothing to serve during a cold start. Eleven deploys in a day made that roughly
# five minutes of daily 502s — which is what the team experienced as the app
# "randomly breaking", and what took out the work-clock poll and the WebSocket.
#
# esbuild does this in ~40ms and deliberately does NOT type-check, so the known
# type-error backlog cannot block a deploy — presumably why tsx was reached for.
RUN bun run build

ENV NODE_ENV=production
EXPOSE 1337

# 40s covered the old transpile-on-boot. A compiled bundle listens in about two,
# so waiting 40 only delays the healthy signal the deploy gate watches for.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:1337/api/health || exit 1

# Compiled output, not source.
#
# The previous comment here claimed a bundle would break "Drizzle migrations and
# plugin registry by path". Both were checked and neither holds:
#   - migrationsFolder is `<entry dir>/../drizzle`, which is /app/apps/api/drizzle
#     from dist/ exactly as it was from src/
#   - plugins are STATIC imports in src/plugins/index.ts, not a filesystem scan,
#     so esbuild inlines them (verified present in the built bundle)
# The built bundle was also run directly and confirmed to reach startup and to
# satisfy its own `import.meta.url === argv[1]` main-module check.
CMD ["node", "dist/index.js"]
