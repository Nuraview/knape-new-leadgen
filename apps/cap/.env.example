# Copy to .env on the VPS (/root/nuraview-cap/.env). NEVER commit the real .env.
# Generate each secret with: openssl rand -hex 32

CAP_URL=https://cap.nuraview.com
S3_PUBLIC_URL=https://capstore.nuraview.com

NEXTAUTH_SECRET=
DATABASE_ENCRYPTION_KEY=
MEDIA_SERVER_WEBHOOK_SECRET=

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

MINIO_ROOT_USER=cap-admin
MINIO_ROOT_PASSWORD=

# Login OTP emails, sent from auth@$RESEND_FROM_DOMAIN. Reuses the NuraView CRM
# Resend key. The domain MUST be verified in that Resend account (verified:
# nuraview.com — NOT hello.nuraview.com; Resend treats subdomains separately).
# If the key is empty, codes are printed to `docker logs cap-web`.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=nuraview.com

# Only these domains may create NEW accounts (comma-separated). Existing
# users always keep sign-in. Empty = open signup (NEVER leave empty in prod).
CAP_ALLOWED_SIGNUP_DOMAINS=nuraview.com

# Shared secret for the gifmaker sidecar (whole-video preview GIFs).
# Must match CAP_GIFMAKER_SECRET in the CRM's Vercel env. openssl rand -hex 32
GIFMAKER_SECRET=

# Deepgram API key — powers the Transcript tab, AI Summary, and chapters.
# Get one (free $200 credit) at https://console.deepgram.com/ . Empty =
# transcription skipped, share pages show "No transcript available".
DEEPGRAM_API_KEY=
