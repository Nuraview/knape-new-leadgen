# Copy to .env and fill in. DO NOT COMMIT .env.

# NuraView CRM backend. https://crmx1.nuraview.com in prod (self-hosted on the
# VPS); cloudflared tunnel URL for local dev.
NEXTCRM_URL=

# Must match the CRM's SCRAPER_API_KEY env.
SCRAPER_API_KEY=

# Comma-separated Upwork search queries this scraper will run every tick.
SEARCH_QUERIES=next.js,react,nestjs

# Egress proxy(ies), comma-separated (camoufox proxy.server). REQUIRED in prod:
# Upwork/Cloudflare blocked the bare VPS datacenter IP on 2026-07-25 (Turnstile
# challenge -> "500 - Upwork" -> 0 job cards). We route egress through a
# Cloudflare WARP proxy on the VPS to present a different IP:
#   PROXY_LIST=socks5://172.20.0.1:40000
# (172.20.0.1 = the scraper's docker bridge gateway; a warp-relay socat unit on
#  the host forwards it to WARP's 127.0.0.1:40000. See warp-svc/warp-connect/
#  warp-relay systemd units.) A residential proxy is the more robust long-term
# fix if the WARP IP gets flagged: PROXY_LIST=socks5://user:pass@host:port
PROXY_LIST=

# Concurrent search keywords. Higher = more throughput but more concurrent proxy
# egress (raises re-detection risk). Kept at 1 after the IP-block incident.
MAX_PARALLEL_KEYWORDS=1

# Jobs per query per tick. Each job takes ~10–20s (Cloudflare + detail scrape),
# so keep this modest or raise REQUEST_TIMEOUT accordingly.
LIMIT=8

# Minutes between ticks. Minimum 1.
INTERVAL_MIN=15

# Seconds to wait on the local scraper (covers LIMIT * per-job time plus slack).
REQUEST_TIMEOUT=1500

# Upwork credentials used by the scraper when cookies expire.
# If cookies.json stays valid, these are effectively unused.
UPWORK_EMAIL=
UPWORK_PASSWORD=

HEADLESS=true
LOG_LEVEL=info
