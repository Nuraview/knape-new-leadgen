# NuraView SPA (Vite + React).
#
# Two stages: build the static bundle, then serve it from nginx. The container
# serves ONLY static files — /api is routed to the API container by the host
# nginx, so the SPA never proxies.
FROM node:22-slim AS build

WORKDIR /app
RUN npm install -g bun@1.3.1

# Deploy-only root manifest. The committed root package.json lists apps/web
# (the legacy Next app), which this image deliberately does not ship — with it
# present, the workspace set would not match and bun would fail.
COPY deploy/package.app.json ./package.json
COPY bun.lock bunfig.toml ./
COPY apps/app/package.json ./apps/app/
COPY apps/api/package.json ./apps/api/
COPY packages/email/package.json ./packages/email/
COPY packages/libs/package.json ./packages/libs/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/permissions/package.json ./packages/permissions/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# NOT --frozen-lockfile: the lockfile describes the full workspace including
# apps/web, which is intentionally absent here. Versions still come from each
# package.json's ranges. Revisit once apps/web is retired and the lockfile
# matches the deployed set again.
RUN bun install

COPY packages ./packages
COPY apps/app ./apps/app
COPY i18n ./i18n

# apps/api source is NOT copied.
#
# It used to be, and it meant every API-only change invalidated this layer and
# forced a full 6-minute SPA rebuild for a file the bundle never reads. Vite
# strips types with esbuild and does not typecheck, so the API's .ts files are
# not an input to the bundle — only apps/api/package.json is, and that is
# already copied above for the workspace install.

RUN bun run --filter @nuraview/permissions build

# VITE_* are inlined at build time. EMPTY on purpose: the app then talks to its
# own origin, so ONE image serves crmx1 and crmx2 alike. Baking an absolute host
# pinned the image to a single domain — the crmx2 bundle served from crmx1 sent
# every request cross-origin with the session cookie scoped to the wrong host,
# which presents as a login loop rather than as a config error.
# Override with --build-arg only for a bundle that must call a different origin.
ARG VITE_API_URL=
ARG VITE_APP_URL=
ARG VITE_CLIENT_URL=
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_APP_URL=${VITE_APP_URL} \
    VITE_CLIENT_URL=${VITE_CLIENT_URL}

RUN bun run --filter @nuraview/app build

FROM nginx:alpine

COPY --from=build /app/apps/app/dist /usr/share/nginx/html

# SPA history fallback: every non-asset path must return index.html or a deep
# link like /leads/kanban 404s on refresh.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location /assets/ {' \
  '    expires 1y;' \
  '    add_header Cache-Control "public, immutable";' \
  '  }' \
  '  location / {' \
  '    try_files $uri /index.html;' \
  '    add_header Cache-Control "no-store";' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
